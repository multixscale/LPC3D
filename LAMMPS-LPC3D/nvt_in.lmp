# created by fftool

units real
boundary p p p

atom_style full
bond_style harmonic
angle_style harmonic

read_data data.lmp
# read_restart restart.*.lmp

special_bonds lj/coul 0.0 0.0 0.5

pair_style hybrid lj/cut/coul/long 12.0 12.0
pair_modify mix geometric tail yes
kspace_style pppm 1.0e-4

pair_coeff    1    1 lj/cut/coul/long     0.155402     3.166000  # OW OW
pair_coeff    2    2 lj/cut/coul/long     0.000000     0.000000  # HW HW
pair_coeff    3    3 lj/cut/coul/long     0.065999     3.500000  # CG1 CG1
pair_coeff    4    4 lj/cut/coul/long     0.065999     3.500000  # CG2 CG2

group water type 1 2
group elec type 3 4 

#minimize 1.0e-4 1.0e-6 100 1000
reset_timestep 0

fix SHAKE all shake 0.0001 20 0 b 1
neigh_modify exclude group elec elec


neighbor 2.0 bin

timestep 1.0

variable TK equal 298.0
variable PBAR equal 1.0

compute myTemp water temp
thermo_style multi
thermo              100

velocity water create ${TK} 12345

# FOR NVT simulations
fix 1 elec setforce 0.0 0.0 0.0
fix 2 water nvt temp ${TK} ${TK} 100


restart 1000 restart1 restart2
dump TRAJ all xyz 100 positions.xyz
dump_modify TRAJ element O H CG1 CG2

run 100000

write_restart restart.*.lmp
write_data data.*.lmp

